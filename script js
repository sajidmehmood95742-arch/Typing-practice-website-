        // --- Utility Functions ---
        function getLocalStorage(key, defaultValue) {
            try {
                const item = localStorage.getItem(key);
                return item ? JSON.parse(item) : defaultValue;
            } catch (e) {
                console.error("Error reading from localStorage", e);
                return defaultValue;
            }
        }

        function setLocalStorage(key, value) {
            try {
                localStorage.setItem(key, JSON.stringify(value));
            } catch (e) {
                console.error("Error writing to localStorage", e);
            }
        }

        // --- Theme Toggle ---
        function applyTheme(theme) {
            document.body.className = theme;
            themeSwitch.checked = (theme === 'dark-theme');
        }

        function toggleTheme() {
            const currentTheme = document.body.className;
            const newTheme = currentTheme === 'dark-theme' ? 'light-theme' : 'dark-theme';
            applyTheme(newTheme);
            setLocalStorage(LS_THEME, newTheme);
        }

        themeSwitch.addEventListener('change', toggleTheme);

        // Initialize theme on load
        const savedTheme = getLocalStorage(LS_THEME, 'light-theme');
        applyTheme(savedTheme);

        // --- Navigation ---
        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            document.getElementById(pageId).classList.add('active');

            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
            });
            document.querySelector(`.nav-link[data-page="${pageId}"]`).classList.add('active');

            if (pageId === 'home') {
                updateHomePageStats();
            } else if (pageId === 'leaderboard') {
                loadLeaderboard();
            } else if (pageId === 'practice') {
                // Ensure practice page is ready
                if (!testStarted) {
                    resetTest();
                }
            }
        }

        navLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const pageId = e.target.dataset.page;
                showPage(pageId);
            });
        });

        // Handle "Start Typing Now!" button on home page
        document.querySelector('#home .btn-primary').addEventListener('click', (e) => {
            e.preventDefault();
            const pageId = e.target.dataset.page;
            showPage(pageId);
        });

        // --- Test Initialization and Generation ---
        function getRandomWords(numWords) {
            let selectedWords = [];
            while (selectedWords.length < numWords) {
                const randomIndex = Math.floor(Math.random() * texts.length);
                const textWords = texts[randomIndex].split(' ');
                selectedWords = selectedWords.concat(textWords);
            }
            // Ensure we don't exceed numWords and join with single spaces
            return selectedWords.slice(0, numWords).join(' ');
        }

        function loadText() {
            let textToDisplay;
            if (selectedWords > 0) {
                textToDisplay = getRandomWords(selectedWords);
            } else {
                // Fallback or specific logic for non-word based tests if any
                textToDisplay = texts[Math.floor(Math.random() * texts.length)];
            }

            currentText = textToDisplay.split('');
            typingTextElement.innerHTML = '';
            currentText.forEach(char => {
                const span = document.createElement('span');
                span.textContent = char;
                typingTextElement.appendChild(span);
            });
            typingInputElement.value = '';
            typingInputElement.focus();
            typedText = [];
            charIndex = 0;
            errors = 0;
            updateCursor();
            updateStats();
        }

        function updateCursor() {
            const spans = typingTextElement.querySelectorAll('span');
            spans.forEach((span, index) => {
                span.classList.remove('current');
            });
            if (charIndex < spans.length) {
                spans[charIndex].classList.add('current');
            }
        }

        // --- Timer Functions ---
        function startTimer() {
            if (intervalId) clearInterval(intervalId);
            timer = selectedTime;
            timerDisplay.textContent = timer;
            intervalId = setInterval(() => {
                timer--;
                timerDisplay.textContent = timer;
                if (timer <= 0) {
                    clearInterval(intervalId);
                    endTest();
                }
            }, 1000);
        }

        function stopTimer() {
            clearInterval(intervalId);
            intervalId = null;
        }

        // --- Test Logic ---
        function resetTest() {
            stopTimer();
            testStarted = false;
            timer = selectedTime;
            charIndex = 0;
            errors = 0;
            typedText = [];
            typingInputElement.value = '';
            typingInputElement.disabled = false;
            typingInputElement.classList.remove('finished'); // Remove finished state if applied
            wpmDisplay.textContent = '0';
            accuracyDisplay.textContent = '0%';
            errorsDisplay.textContent = '0';
            timerDisplay.textContent = selectedTime;
            loadText();
        }

        function updateStats() {
            const totalCharsTyped = typedText.length;
            const correctChars = totalCharsTyped - errors;
            const accuracy = totalCharsTyped === 0 ? 0 : ((correctChars / totalCharsTyped) * 100).toFixed(0);

            // WPM calculation: (correctly typed characters / 5) / (time in minutes)
            // If timer is running, calculate based on elapsed time. If test ended, use selectedTime.
            const timeElapsed = testStarted ? (selectedTime - timer) : selectedTime;
            const minutes = timeElapsed / 60;
            const wpm = minutes > 0 ? Math.round((correctChars / 5) / minutes) : 0;

            wpmDisplay.textContent = wpm;
            accuracyDisplay.textContent = `${accuracy}%`;
            errorsDisplay.textContent = errors;
        }

        function endTest() {
            stopTimer();
            testStarted = false;
            typingInputElement.disabled = true;
            typingInputElement.classList.add('finished'); // Visual cue that test is over

            const finalWPM = parseInt(wpmDisplay.textContent);
            const finalAccuracy = parseInt(accuracyDisplay.textContent);
            const finalErrors = parseInt(errorsDisplay.textContent);

            // Update modal results
            modalWPM.textContent = finalWPM;
            modalAccuracy.textContent = `${finalAccuracy}%`;
            modalErrors.textContent = finalErrors;
            modalTime.textContent = `${selectedTime}s`;

            showResultsModal();
            updateGlobalStats(finalWPM, finalAccuracy);
            saveTestResult(finalWPM, finalAccuracy, selectedTime);
        }

        function handleTypingInput(e) {
            if (!testStarted) {
                startTimer();
                testStarted = true;
            }

            const inputChar = e.data; // Get the character typed
            const allSpans = typingTextElement.querySelectorAll('span');

            // Handle backspace
            if (e.inputType === 'deleteContentBackward') {
                if (charIndex > 0) {
                    charIndex--;
                    if (typedText[charIndex] !== currentText[charIndex]) {
                        errors--;
                    }
                    typedText.pop();
                    allSpans[charIndex].classList.remove('correct', 'incorrect');
                }
            } else if (inputChar) {
                // Handle regular character input
                if (charIndex < currentText.length) {
                    typedText.push(inputChar);
                    if (inputChar === currentText[charIndex]) {
                        allSpans[charIndex].classList.add('correct');
                        allSpans[charIndex].classList.remove('incorrect');
                    } else {
                        allSpans[charIndex].classList.add('incorrect');
                        allSpans[charIndex].classList.remove('correct');
                        errors++;
                    }
                    charIndex++;
                }
            }

            updateCursor();
            updateStats();

            // Check if all characters are typed
            if (charIndex === currentText.length) {
                endTest();
            }
        }

        // --- Event Listeners ---
        typingInputElement.addEventListener('input', handleTypingInput);

        restartButton.addEventListener('click', resetTest);

