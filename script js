        window.addEventListener('click', (event) => {
            if (event.target === resultsModal) {
                hideResultsModal();
            }
        });

        // --- Global Stats and Leaderboard ---
        function updateHomePageStats() {
            let totalTests = getLocalStorage(LS_TOTAL_TESTS, 0);
            let bestWPM = getLocalStorage(LS_BEST_WPM, 0);
            let totalWPM = getLocalStorage(LS_TOTAL_WPM, 0);

            totalTestsDisplay.textContent = totalTests;
            bestWPMDisplay.textContent = bestWPM;
            avgWPMDisplay.textContent = totalTests > 0 ? Math.round(totalWPM / totalTests) : 0;
        }

        function updateGlobalStats(wpm, accuracy) {
            let totalTests = getLocalStorage(LS_TOTAL_TESTS, 0);
            let bestWPM = getLocalStorage(LS_BEST_WPM, 0);
            let totalWPM = getLocalStorage(LS_TOTAL_WPM, 0);

            totalTests++;
            totalWPM += wpm;
            if (wpm > bestWPM) {
                bestWPM = wpm;
            }

            setLocalStorage(LS_TOTAL_TESTS, totalTests);
            setLocalStorage(LS_BEST_WPM, bestWPM);
            setLocalStorage(LS_TOTAL_WPM, totalWPM);

            updateHomePageStats(); // Refresh home page stats immediately
        }

        function saveTestResult(wpm, accuracy, time) {
            let results = getLocalStorage(LS_TEST_RESULTS, []);
            const playerName = "Guest"; // For now, use Guest. Could add input later.
            const date = new Date().toLocaleDateString();

            results.push({ name: playerName, wpm: wpm, accuracy: accuracy, time: time, date: date });

            // Keep only top N results, e.g., 100, and sort by WPM
            results.sort((a, b) => b.wpm - a.wpm || b.accuracy - a.accuracy); // Sort by WPM descending, then accuracy
            results = results.slice(0, 100); // Keep only top 100

            setLocalStorage(LS_TEST_RESULTS, results);
        }

        function loadLeaderboard() {
            const leaderboardTableBody = document.querySelector('#leaderboard-table tbody');
            leaderboardTableBody.innerHTML = ''; // Clear existing entries
            const results = getLocalStorage(LS_TEST_RESULTS, []);

            if (results.length === 0) {
                leaderboardTableBody.innerHTML = '<tr><td colspan="5" style="text-align: center;">No results yet. Start typing!</td></tr>';
                return;
            }

            results.forEach((result, index) => {
                const row = leaderboardTableBody.insertRow();
                row.insertCell().textContent = index + 1; // Rank
                row.insertCell().textContent = result.name;
                row.insertCell().textContent = result.wpm;
                row.insertCell().textContent = `${result.accuracy}%`;
                row.insertCell().textContent = result.date;
            });
        }


